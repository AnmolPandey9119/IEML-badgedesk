# ==========================================================
# Copy this file to ".env" and fill in real values.
# ".env" itself must NEVER be committed to git.
# ==========================================================

# ---------- Server ----------
# Host/port the FastAPI server itself runs on.
# 0.0.0.0 so it's reachable from other laptops on the LAN,
# not just from this machine.
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# Comma-separated list of origins allowed to call this API.
# Add every counter laptop's URL here, or "*" during local
# event setup if all laptops are on a trusted closed LAN.
ALLOWED_ORIGINS=*


# ---------- Google Sheet Sync (current primary data source) ----------
# This is the real-time registration spreadsheet. Whenever someone
# registers on the event website, a new row lands here. The backend
# reads it, assigns a URN to any new row, and saves it into the
# local master store (master.db).
#
# HOW TO GET THE RIGHT LINK:
#   1. Open the Google Sheet -> Share -> "Anyone with the link: Viewer"
#   2. File -> Share -> Publish to web is NOT needed. Just copy the
#      normal sheet URL, e.g.:
#      https://docs.google.com/spreadsheets/d/XXXXXXXXXXXXXXXX/edit#gid=0
#   3. Paste ONLY that URL below as GOOGLE_SHEET_URL — the backend
#      converts it to a CSV export link internally.
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1OYrHd22A2gfBIaMwyXvF3zhdzJK2-3istiX5s1ZKbC0/edit?usp=sharing

# How often the background auto-sync checks the sheet for new
# registrants (in minutes). The "Sync Now" button in the dashboard
# also triggers this on demand, any time.
SHEET_SYNC_INTERVAL_MINUTES=5

# Master switch for the whole sheet-sync feature. Keep true while
# using the spreadsheet as the data source.
SHEET_SYNC_ENABLED=true


# ---------- Legacy: Organization REST API (kept, OFF by default) ----------
# This was the original design before we learned the real source of
# truth is a Google Sheet, not a REST API. Left in place (not
# deleted) in case IEML ever exposes a real org API later — just
# switch USE_LEGACY_ORG_API to true and fill these in.
USE_LEGACY_ORG_API=false
DEMO_MODE=true
ORG_API_BASE_URL=
ORG_API_KEY=
ORG_API_TIMEOUT_SECONDS=8


# ---------- Event Info ----------
# This system is reused across every IEML event/exhibition.
# Set this to whichever event is currently running — it's the
# only thing that changes between events, everything else in
# the codebase stays generic.
EVENT_NAME=IEML Mart Sourcing Days


# ---------- Admin Auth ----------
# Every counter operator must log in with these before they can
# search/register/print. Password is stored as a bcrypt HASH,
# never plaintext — generate one with generate_password_hash.py.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRY_HOURS=12


# ---------- Mart Days Gate (DEPRECATED) ----------
# No longer used — kept only so an existing .env doesn't need
# editing during rollout. Replaced by ADMIN_MARTDAYS_USERNAME below
# (a separate login instead of an in-app second password). Safe to
# delete this line whenever convenient.
MART_DAYS_GATE_PASSWORD=

# ---------- Mart Days Operator Auth (badge desk) ----------
# NEW. A SEPARATE badge desk login, permanently scoped to Mart Days —
# generate the hash the same way as ADMIN_PASSWORD_HASH above, using
# generate_password_hash.py. Logging in with this account opens the
# badge desk straight into Mart Days mode; logging in with
# ADMIN_USERNAME above opens it into Other Events — no in-app
# switch/gate needed anymore.
ADMIN_MARTDAYS_USERNAME=
ADMIN_MARTDAYS_PASSWORD_HASH=
